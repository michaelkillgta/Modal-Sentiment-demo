# Copy this file to .env.local (or .env) and paste your endpoint URL.
#
#   cp .env.example .env.local
#
# Use the ...modal.run FUNCTION URL printed by `modal deploy` — NOT the
# modal.com/apps/... dashboard page, which is an HTML page and rejects POSTs.
# You can look the URL up again at any time with:
#
#   python -m modal app info modal-sentiment-demo
#
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser, and it
# reads them when the dev server starts — restart `npm run dev` after editing.
NEXT_PUBLIC_MODAL_ENDPOINT=https://YOUR-WORKSPACE--modal-sentiment-demo-sentimentmodel-predict.modal.run
